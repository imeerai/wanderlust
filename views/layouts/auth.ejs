<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Wanderlust' : 'Wanderlust' %></title>
  <meta name="robots" content="noindex">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="icon" href="/images/favicon.ico">
  <script nonce="<%= nonce %>">try{var t=localStorage.getItem("wl-theme");if(t==="dark")document.documentElement.setAttribute("data-theme","dark")}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/wl.css">
</head>
<body class="wl">
  <%- body %>
  <script src="/js/auth.js" defer></script>
</body>
</html>
