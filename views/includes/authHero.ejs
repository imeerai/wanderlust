<aside class="wl-auth-hero">
  <% if (hero && hero.url) { %><img src="<%= hero.url %>" alt="<%= hero.caption %>"><% } %>
  <div class="shade"></div>
  <a class="logo" href="/" aria-label="Wanderlust home">
    <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#e61e4d"/><path d="M7 11l4.2 11 4.8-8 4.8 8L25 11" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>wanderlust</span>
  </a>
  <div class="cap">
    <h2><%= headline %></h2>
    <% if (typeof sub !== 'undefined' && sub) { %><p><%= sub %></p><% } %>
  </div>
</aside>
